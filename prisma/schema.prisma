generator client {
  provider   = "prisma-client"
  output     = "./generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum TeamRole {
  Leader
  Member
}

enum Education {
  SMA
  SMK
  D3
  D4
  S1
}

enum CompetitionName {
  PDC
  IPPC
  BCC
  STEM
}

enum Gender {
  Male
  Female
}

enum DocumentStatus {
  AWAITING_UPLOAD
  PENDING
  VERIFIED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  ACCEPTED
}

enum TeamStatus {
  NOT_REGISTERED
  PENDING
  ACCEPTED
}

enum EventStatus {
  REJECTED
  PENDING
  ACCEPTED
}

enum QuizTypes {
  MATHEMATICS
  PHYSICS
  ESSAY
}

enum EventType {
  M_RUN
  ETU
  M_CARE
  M_EXPO
  M_TALKS
}

enum JerseySize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum BloodType {
  A
  B
  AB
  O
}

enum Rhesus {
  POSITIVE
  NEGATIVE
  NOT_KNOWN
}

enum KlinikActivity {
  BOTH
  DONATE_BLOOD
  EYE_CHECK
}

enum Kategori {
  UMUM
  MAHASISWA
}

enum SourceInfo {
  INSTAGRAM_MFEST_ITB
  FRIEND
  BANNER
  OTHER
}

enum KodeSoal {
  A
  B
  C
  TECHMEET
}

enum MotorType {
  MATIC
  MANUAL
}

enum MTalksSessionType {
  TALKS_1
  TALKS_2
  TALKS_3
  TALKS_4
}
enum MExpoSessionType {
  EXPO_DAY_1
  EXPO_DAY_2
}

model CompRegistration {
  id                String          @id @default(uuid())
  userId            String
  leaderUserId      String?
  leaderEmail       String?
  leaderName        String?
  leaderPhoneNumber String?
  teamInstitution   String?
  teamName          String?
  teamId            String?         @unique
  paymentId         String          @unique
  paymentFee        Int
  paymentProofUrl   String
  statusOrder       String?         @default("PENDING")
  teamStatus        TeamStatus?
  competitionName   CompetitionName

  // Should've create an entire seperate model for submission file
  submissionFileName       String?
  submissionFileUrl        String?
  submissionFileKey        String?
  submissionFileCreatedAt  DateTime @default(now())
  submissionFileUploaded   Boolean  @default(false)
  submissionFileSubmitted  Boolean  @default(false)
  submissionFileName2      String?
  submissionFileUrl2       String?
  submissionFileKey2       String?
  submissionFileCreatedAt2 DateTime @default(now())
  submissionFileUploaded2  Boolean  @default(false)
  submissionFileSubmitted2 Boolean  @default(false)
  mentor                   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  team                     Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)

  @@index([userId])
  @@index([teamId])
  @@index([paymentId])
  @@map("comp_registration")
}

model EventRegistration {
  // Mandatory Fields
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType EventType

  // General
  participantName      String?
  activeEmail          String?
  phoneNumber          String?
  fullAddress          String?
  emergencyContact     String?
  emergencyContactName String?
  isITB                Boolean?    @default(false)
  nimITB               String?
  majorITB             String?
  institution          String?
  sourceInfo           SourceInfo?
  gender               Gender?
  isPresence           Boolean?    @default(false)
  almamater            String?
  followIgUrl     String?


  // M-Talks & M-Expo Specific
  activeSocial        String?
  reasonToParticipate String?
  interestedTopic     String?

  talksSessions       MTalksSessionType[]
  expoSessions        MExpoSessionType[]

  talksSession1Presence Boolean? @default(false)
  talksSession2Presence Boolean? @default(false)
  talksSession3Presence Boolean? @default(false)
  talksSession4Presence Boolean? @default(false)

  expoDay1Presence Boolean? @default(false)
  expoDay2Presence Boolean? @default(false)

  // M-Care Specific
  clinicActivity KlinikActivity?
  memenuhiSyarat Boolean?        @default(false) // Consent Klinik

  // M-Run Specifics
  age             String?
  ktpUrl          String?
  buktiBayarUrl   String?
  category        Kategori? // 5K, 10K, etc
  jerseySize      JerseySize?
  isAlumniHMM     Boolean?     @default(false)
  isHMM           Boolean?     @default(false)
  nimHMM          String? // Khusus verifikasi HMM
  bloodType       BloodType?
  rhesus          Rhesus?
  riwayatPenyakit Boolean?     @default(false)
  detailPenyakit  String? // Kapan terakhir kambuh
  alergi          Boolean?
  detailAlergi    String?
  siapLomba       Boolean?     @default(false) // Consent M-Run
  eventStatus     EventStatus? @default(PENDING)
  paymentStatus   EventStatus? @default(PENDING)
  batch           String?
  price           Int?

  // ETU speficfics
  merekKendaraan  String?
  tahunBuat       String?
  platNomor       String?
  lastServiceDate String?
  nimOrNip        String? // Buat ETU / Mexpo
  isSopCompliant  Boolean?   @default(false) // Consent ETU
  motorType       MotorType?

  @@index([userId])
  @@index([eventType])
  @@map("event_registration")
}

model User {
  id                String              @id
  name              String
  email             String              @unique
  emailVerified     Boolean
  image             String?
  phoneNumber       String?
  domicile          String?
  institution       String?
  major             String?
  education         Education?
  semester          Int?
  role              Role                @default(USER)
  verified          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  accounts          Account[]
  registration      CompRegistration[]
  documents         Documents?
  eventRegistration EventRegistration[]
  quizResults       quizResult[]
  sessions          Session[]
  team_member       TeamMember[]
  examSession       ExamSession[]

  @@index([id])
  @@index([email])
  @@map("user")
}

model Documents {
  id                    String             @id @default(cuid())
  userId                String             @unique
  identityCardImageUrl  String?
  twibbonImageUrl       String?
  followIgImageUrl      String?
  identityCardImageKey  String?
  twibbonImageKey       String?
  followIgImageKey      String?
  identityCardCreatedAt DateTime?          @default(now())
  twibbonCreatedAt      DateTime?          @default(now())
  followIgCreatedAt     DateTime?          @default(now())
  identityCardStatus    DocumentStatus?    @default(AWAITING_UPLOAD)
  twibbonStatus         DocumentStatus?    @default(AWAITING_UPLOAD)
  followIgStatus        DocumentStatus?    @default(AWAITING_UPLOAD)
  identityCardVerified  Boolean?           @default(false)
  twibbonVerified       Boolean?           @default(false)
  followIgVerified      Boolean?           @default(false)
  status                VerificationStatus @default(NOT_SUBMITTED)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([id])
  @@map("documents")
}

model Team {
  id                     String            @id @default(cuid())
  name                   String?           @unique
  competition            CompetitionName?
  paymentId              String?           @unique
  paymentProofUrl        String?
  leaderUserId           String?
  leaderEmail            String?
  leaderName             String?
  leaderPhoneNumber      String?
  teamInstitution        String?
  teamStatus             TeamStatus?       @default(NOT_REGISTERED)
  status                 String?           @default("PENDING")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  verificationDeadlineAt DateTime?
  registration           CompRegistration?
  members                TeamMember[]

  @@index([name])
  @@index([paymentId])
  @@index([leaderUserId])
  @@index([id])
  @@map("team")
}

model TeamMember {
  userId      String
  teamId      String
  name        String?
  email       String?
  institution String?
  role        TeamRole?
  joinDate    DateTime? @default(now())
  verified    Boolean   @default(false)
  teamName    String?
  kodeSoal    KodeSoal?
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_member")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model ExamSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model quizResult {
  id                 String    @id @default(cuid())
  userId             String
  score              Int
  totalQuestions     Int
  timeSpent          Int
  answers            Json
  essayAnswer        String?
  essayAnswerFileUrl String?
  essayAnswerFileKey String?
  createdAt          DateTime  @default(now())
  type               QuizTypes
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExamState {
  id         String  @id @default(cuid())
  essayState Boolean @default(false)
  examOpen   Boolean @default(false)
}
