generator client {
  provider   = "prisma-client"
  output     = "./generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}



enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum TeamRole {
  Leader
  Member
}

enum Education {
  SMA
  SMK
  D3
  D4
  S1
}

enum CompetitionName {
  PDC
  IPPC
  BCC
  STEM
}

enum Gender {
  Male
  Female
}

enum DocumentStatus {
  AWAITING_UPLOAD
  PENDING
  VERIFIED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  ACCEPTED
}

enum TeamStatus {
  NOT_REGISTERED
  PENDING
  ACCEPTED
}

enum QuizTypes {
  MATHEMATICS
  PHYSICS
  ESSAY
}

enum EventType {
  M_RUN
  ETU
  M_CARE
  M_EXPO
  M_TALKS
}

enum JerseySize {
  S
  M
  L
  XL
  XXL
}

enum BloodType {
  A
  B
  AB
  O
}

enum Rhesus {
  POSITIVE
  NEGATIVE
  NOT_KNOWN
}

enum KlinikActivity {
  DONATE_BLOOD
  EYE_CHECK
}

enum Kategori {
  UMUM
  MAHASISWA
}

enum SourceInfo {
  INSTAGRAM_MFEST_ITB
  FRIEND
  BANNER
  OTHER
}

model CompRegistration {
  id                      String          @id @default(uuid())
  userId                  String
  leaderUserId            String?
  leaderEmail             String?
  leaderName              String?
  leaderPhoneNumber       String?
  teamInstitution         String?
  teamName                String?
  teamId                  String?          @unique
  paymentId               String          @unique
  paymentFee              Int
  paymentProofUrl         String
  statusOrder             String?         @default("PENDING")
  teamStatus              TeamStatus?
  competitionName         CompetitionName
  submissionFileName      String?
  submissionFileUrl       String?
  submissionFileKey       String?
  submissionFileCreatedAt DateTime        @default(now())
  submissionFileUploaded  Boolean         @default(false)
  submissionFileSubmitted Boolean         @default(false)
  mentor                  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  team                    Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  isVerified              Boolean         @default(false)

  @@index([userId])
  @@index([teamId])
  @@index([paymentId])
  @@map("comp_registration")
}

model EventRegistration {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType       EventType

  // General
  participantName String?
  activeEmail     String?
  phoneNumber     String?
  fullAddress     String?
  emergencyContact  String?
  emergencyContactName String?
  isITB           Boolean?     @default(false)
  nimITB          String?
  majorITB        String?
  sumberInfo      SourceInfo?
  gender            Gender?


  // M-Talks Specific
  activeSocial        String?
  reasonToParticipate String?
  interestedTopic     String?

  // M-Care Specific
  clinicActivity   KlinikActivity[] 
  memenuhiSyarat    Boolean?     @default(false) // Consent Klinik

// M-Run Specifics
  age             Int?
  ktpUrl          String?
  category        Kategori?      // 5K, 10K, etc
  jerseySize      JerseySize?
  isAlumniHMM     Boolean?     @default(false)
  isHMM           Boolean?     @default(false)
  nimHMM          String?      // Khusus verifikasi HMM
  bloodType   BloodType?
  rhesus          Rhesus?
  riwayatPenyakit Boolean?     @default(false)
  detailPenyakit  String?      // Kapan terakhir kambuh
  alergi          Boolean?
  detailAlergi    String?
  siapLomba       Boolean?     @default(false) // Consent M-Run
  buktiBayarUrl   String?

  // ETU speficfics
  merekKendaraan  String?
  tahunBuat       Int?
  platNomor       String?
  lastServiceDate String?
  nimOrNip        String?      // Buat ETU / Mexpo
  isSopCompliant  Boolean?     @default(false) // Consent ETU



  @@index([userId])
  @@index([eventType])
}

model User {
  id                String              @id
  name              String
  email             String              @unique
  emailVerified     Boolean
  image             String?
  phoneNumber       String?
  domicile          String?
  institution       String?
  major             String?
  education         Education?
  semester          Int?
  role              Role                @default(USER)
  verified          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  accounts          Account[]
  registration      CompRegistration[]
  documents         Documents?
  eventRegistration EventRegistration[]
  quizResults       quizResult[]
  sessions          Session[]
  team_member       TeamMember[]
  examSession       ExamSession[]

  @@index([id])
  @@index([email])
  @@map("user")
}

model Documents {
  id                    String             @id @default(cuid())
  userId                String             @unique
  identityCardImageUrl  String?
  twibbonImageUrl       String?
  followIgImageUrl      String?
  identityCardImageKey  String?
  twibbonImageKey       String?
  followIgImageKey      String?
  identityCardCreatedAt DateTime?          @default(now())
  twibbonCreatedAt      DateTime?          @default(now())
  followIgCreatedAt     DateTime?          @default(now())
  identityCardStatus    DocumentStatus?    @default(AWAITING_UPLOAD)
  twibbonStatus         DocumentStatus?    @default(AWAITING_UPLOAD)
  followIgStatus        DocumentStatus?    @default(AWAITING_UPLOAD)
  identityCardVerified  Boolean?           @default(false)
  twibbonVerified       Boolean?           @default(false)
  followIgVerified      Boolean?           @default(false)
  status                VerificationStatus @default(NOT_SUBMITTED)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([id])
  @@map("documents")
}

model Team {
  id                     String            @id @default(cuid())
  name                   String?           @unique
  competition            CompetitionName?
  paymentId              String?           @unique
  paymentProofUrl        String?
  leaderUserId           String?
  leaderEmail            String?
  leaderName             String?
  leaderPhoneNumber      String?
  teamInstitution        String?
  teamStatus             TeamStatus?       @default(NOT_REGISTERED)
  status                 String?           @default("PENDING")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  verificationDeadlineAt DateTime?
  registration           CompRegistration?
  members                TeamMember[]

  @@index([name])
  @@index([paymentId])
  @@index([leaderUserId])
  @@index([id])
  @@map("team")
}

model TeamMember {
  userId      String
  teamId      String
  name        String?
  email       String?
  institution String?
  role        TeamRole?
  joinDate    DateTime? @default(now())
  verified    Boolean   @default(false)
  teamName    String?
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_member")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model ExamSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model quizResult {
  id                  String    @id @default(cuid())
  userId              String
  score               Int
  totalQuestions      Int
  timeSpent           Int
  answers             Json
  essayAnswer         String?
  essayAnswerFileUrl  String?
  essayAnswerFileKey  String?
  createdAt           DateTime  @default(now())
  type                QuizTypes
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
